# ==============================================================================
# Environment Configuration Template: Multi-Account Financial Intelligence Agent
# ==============================================================================

# Application Runtime
ENV=development
LOG_LEVEL=info
SECRET_KEY=change-this-in-production-use-strong-entropy
WEBHOOK_SIGNING_SECRET=local-test-hmac-secret-12345

# PostgreSQL 16 + pgvector Database
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/finance_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (Distributed Locks & Token Bucket Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# Apache Kafka Cluster
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TRANSACTIONS_TOPIC=raw-transactions
KAFKA_DLQ_TOPIC=raw-transactions-dlq
KAFKA_CONSUMER_GROUP=finance-agent-categorizer-group

# AI & LLM Provider Configuration
LLM_PROVIDER=minimax
MINIMAX_API_KEY=your-minimax-subscription-key-here
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-optional

# Langfuse Observability & Tracing
LANGFUSE_PUBLIC_KEY=pk-lf-local-test
LANGFUSE_SECRET_KEY=sk-lf-local-test
LANGFUSE_HOST=http://localhost:3001
